[Desktop Entry]
Version=1.0
Type=Application
Name=Discord Bypass
GenericName=DPI Circumvention Utility
Comment=Linux DPI Circumvention & Connectivity Tool for Discord
Name[tr]=Discord Bypass
GenericName[tr]=DPI Aşma Aracı
Comment[tr]=Discord Linux DPI Engelleme ve Bağlantı Aracı
Icon=discord-bypass
Exec=discord-bypass-gui
Terminal=false
Categories=Network;Security;Utility;
Keywords=Discord;DPI;Bypass;Zapret;Network;Turkey;VPN;Proxy;
StartupNotify=false
Actions=Diagnose;Tune;Status;

[Desktop Action Status]
Name=Show Status Notification
Name[tr]=Durum Bildirimini Göster
Exec=discord-bypass notify-status

[Desktop Action Diagnose]
Name=Run Deep Diagnostic
Name[tr]=Derin Ağ Teşhisini Başlat
Exec=x-terminal-emulator -e discord-bypass diagnose

[Desktop Action Tune]
Name=Run Automatic Strategy Tuner
Name[tr]=Otomatik Strateji Bulucuyu Başlat
Exec=x-terminal-emulator -e sudo discord-bypass tune
