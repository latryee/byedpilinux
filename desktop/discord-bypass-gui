    def run_command_in_background(self, title, cmd_args):
        self.append_log(f"\n[+] {title} başlatılıyor...\n")
        def worker():
            try:
                proc = subprocess.Popen(cmd_args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                for line in proc.stdout:
                    GLib.idle_add(self.append_log, line)
                proc.wait()
                GLib.idle_add(self.append_log, f"[OK] {title} tamamlandı.\n")
                GLib.idle_add(self.refresh_status)
            except Exception as e:
                GLib.idle_add(self.append_log, f"[FAIL] Hata oluştu: {e}\n")

        threading.Thread(target=worker, daemon=True).start()

    def on_tune_clicked(self, widget):
        self.append_log("\n============================================================\n")
        self.append_log("⚡ Otomatik Ağ Stratejisi Bulucu Başlatılıyor...\n")
        self.append_log("Lütfen ekrana gelen şifre kutusunda yetki veriniz.\n")
        cmd = ["pkexec", self.binary_path, "tune"]
        self.run_command_in_background("Otomatik Strateji Ayarı (Tune)", cmd)

    def on_test_clicked(self, widget):
        cmd = [self.binary_path, "test"]
        self.run_command_in_background("Bağlantı Testi", cmd)

    def on_diagnose_clicked(self, widget):
        cmd = [self.binary_path, "diagnose"]
        self.run_command_in_background("12 Adımlı Ağ Teşhisi", cmd)

    def on_toggle_service(self, widget):
        btn_label = self.btn_service.get_label()
        action = "stop" if "Durdur" in btn_label else "start"
        cmd = ["pkexec", self.binary_path, action]
        self.run_command_in_background(f"Servis {action}", cmd)

    def on_apply_strategy_clicked(self, widget):
        selected_id = self.combo_strat.get_active_id()
        if not selected_id:
            return
        self.append_log(f"\n[+] Strateji değiştiriliyor: {selected_id}...\n")
        cmd = ["pkexec", self.binary_path, "strategy", "set", selected_id]
        self.run_command_in_background(f"Strateji Uygulama ({selected_id})", cmd)


