        scrolled.set_margin_top(4)

        self.text_view = Gtk.TextView()
        self.text_view.set_editable(False)
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD)
        self.text_view.get_style_context().add_class("console-view")
        self.text_buffer = self.text_view.get_buffer()
        self.append_log("Discord Bypass Kontrol Paneli Hazır.\n")

        scrolled.add(self.text_view)
        vbox.pack_start(scrolled, True, True, 0)

    def append_log(self, text):
        end_iter = self.text_buffer.get_end_iter()
        self.text_buffer.insert(end_iter, text)
        adj = self.text_view.get_vadjustment()
        GLib.idle_add(lambda: adj.set_value(adj.get_upper() - adj.get_page_size()))

    def refresh_status(self):
        def worker():
            try:
                # Read status via unprivileged CLI
                proc = subprocess.run([self.binary_path, "status"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=4)
                output = proc.stdout

                is_active = "ACTIVE (running)" in output
                is_verified = "VERIFIED" in output
                strategy_name = "Bilinmiyor"
                pkts_info = "0 paket"
                voice_ok = "WebRTC socket reachable" in output
                roblox_ok = "Roblox TCP (443)   : [OK]" in output

                for line in output.splitlines():
                    if "Active Strategy" in line:
                        strategy_name = line.split(":", 1)[1].strip()
                    if "Firewall Rules" in line and "(" in line:
                        pkts_info = line[line.find("(")+1:line.find(")")]

                GLib.idle_add(self.update_status_ui, is_active, is_verified, strategy_name, pkts_info, voice_ok, roblox_ok)
            except Exception as e:
                GLib.idle_add(self.update_status_ui, False, False, f"Hata: {e}", "0 paket", False, False)

        threading.Thread(target=worker, daemon=True).start()
        return True

    def update_status_ui(self, is_active, is_verified, strategy_name, pkts_info, voice_ok, roblox_ok):
        if is_active and is_verified:
            self.lbl_status.set_markup("<span class='status-active'>🟢 Bağlantı Aktif &amp; Doğrulandı</span>")
            self.btn_service.set_label("🛑 Servisi Durdur")
            self.btn_service.get_style_context().remove_class("btn-primary")
            self.btn_service.get_style_context().add_class("btn-danger")
        elif is_active:
            self.lbl_status.set_markup("<span class='status-warn'>🟡 Servis Aktif (Doğrulanmadı)</span>")
            self.btn_service.set_label("🛑 Servisi Durdur")
        else:
            self.lbl_status.set_markup("<span class='status-inactive'>🔴 Servis Durduruldu</span>")
            self.btn_service.set_label("▶️ Servisi Başlat")
            self.btn_service.get_style_context().remove_class("btn-danger")
            self.btn_service.get_style_context().add_class("btn-primary")

        self.lbl_strategy.set_markup(f"<span class='info-value'><b>Aktif Strateji:</b> {strategy_name}</span>")
        
        voice_str = "🟢 Hazır &amp; Erişilebilir (0 ms Ping)" if voice_ok else "🟡 Bağlantı Bekleniyor"
        self.lbl_voice.set_markup(f"<span class='info-value'>🎙️ <b>Discord Ses (WebRTC):</b> {voice_str}</span>")

        roblox_str = "🟢 Erişilebilir (Web &amp; İstemci)" if roblox_ok else "🟡 Kontrol Ediliyor / Hazır"
        self.lbl_roblox.set_markup(f"<span class='info-value'>🧱 <b>Roblox Erişimi:</b> {roblox_str}</span>")

        self.lbl_traffic.set_markup(f"<span class='info-value'>🛡️ <b>Güvenlik Duvarı:</b> {pkts_info} işlendi</span>")

    def run_command_in_background(self, title, cmd_args):
        self.append_log(f"\n[+] {title} başlatılıyor...\n")
        def worker():
            try:
                proc = subprocess.Popen(cmd_args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                for line in proc.stdout:
                    GLib.idle_add(self.append_log, line)
                proc.wait()
                GLib.idle_add(self.append_log, f"[OK] {title} tamamlandı.\n")
                GLib.idle_add(self.refresh_status)
            except Exception as e:
                GLib.idle_add(self.append_log, f"[FAIL] Hata oluştu: {e}\n")

        threading.Thread(target=worker, daemon=True).start()

    def on_tune_clicked(self, widget):
        self.append_log("\n============================================================\n")
        self.append_log("Otomatik ağ stratejisi optimizasyonu başlatılıyor...\n")
        self.append_log("Lütfen ekrana gelen şifre kutusunda yetki veriniz.\n")
        # Run pkexec discord-bypass tune
        cmd = ["pkexec", self.binary_path, "tune"]
        self.run_command_in_background("Otomatik Strateji Ayarı (Tune)", cmd)

    def on_test_clicked(self, widget):
        cmd = [self.binary_path, "test"]
        self.run_command_in_background("Bağlantı Testi", cmd)

    def on_diagnose_clicked(self, widget):
        cmd = [self.binary_path, "diagnose"]
        self.run_command_in_background("12 Adımlı Ağ Teşhisi", cmd)

    def on_toggle_service(self, widget):
        btn_label = self.btn_service.get_label()
        action = "stop" if "Durdur" in btn_label else "start"
        cmd = ["pkexec", self.binary_path, action]
        self.run_command_in_background(f"Servis {action}", cmd)


def main():
    app = DiscordBypassApp()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
