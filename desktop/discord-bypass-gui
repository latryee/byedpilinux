    def append_log(self, text):
        end_iter = self.text_buffer.get_end_iter()
        self.text_buffer.insert(end_iter, text)
        adj = self.text_view.get_vadjustment()
        GLib.idle_add(lambda: adj.set_value(adj.get_upper() - adj.get_page_size()))

    def refresh_status(self):
        def worker():
            try:
                proc = subprocess.run([self.binary_path, "status"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=4)
                output = proc.stdout

                is_active = "ACTIVE (running)" in output
                is_verified = "VERIFIED" in output
                strategy_name = "Bilinmiyor"
                strategy_id = "strategy_c"
                pkts_info = "0 paket"
                voice_ok = "WebRTC socket reachable" in output
                roblox_ok = "Roblox TCP (443)   : [OK]" in output
                discord_ok = "Discord TCP (443)  : [OK]" in output

                for line in output.splitlines():
                    if "Active Strategy" in line:
                        strategy_name = line.split(":", 1)[1].strip()
                        if "(" in strategy_name and ")" in strategy_name:
                            strategy_id = strategy_name[strategy_name.rfind("(")+1:strategy_name.rfind(")")].strip()
                    if "Firewall Rules" in line and "(" in line:
                        pkts_info = line[line.find("(")+1:line.find(")")]

                GLib.idle_add(self.update_status_ui, is_active, is_verified, strategy_id, strategy_name, pkts_info, voice_ok, roblox_ok, discord_ok)
            except Exception as e:
                GLib.idle_add(self.update_status_ui, False, False, "error", f"Hata: {e}", "0 paket", False, False, False)

        threading.Thread(target=worker, daemon=True).start()
        return True

    def update_status_ui(self, is_active, is_verified, strategy_id, strategy_name, pkts_info, voice_ok, roblox_ok, discord_ok):
        self.current_strategy_id = strategy_id
        self.current_strategy_name = strategy_name

        # Update Badge
        if is_active and is_verified:
            self.lbl_header_badge.set_text("🟢 AKTİF & DOĞRULANDI")
            self.lbl_header_badge.get_style_context().remove_class("badge-warn")
            self.lbl_header_badge.get_style_context().remove_class("badge-inactive")
            self.lbl_header_badge.get_style_context().add_class("badge-active")
            self.status_short = f"Aktif ({strategy_name})"
            self.btn_service.set_label("🛑 Servisi Durdur")
            self.btn_service.get_style_context().remove_class("btn-primary")
            self.btn_service.get_style_context().add_class("btn-danger")
        elif is_active:
            self.lbl_header_badge.set_text("🟡 AKTİF (DOĞRULANMADI)")
            self.lbl_header_badge.get_style_context().remove_class("badge-active")
            self.lbl_header_badge.get_style_context().remove_class("badge-inactive")
