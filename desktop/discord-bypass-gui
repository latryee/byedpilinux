class DiscordBypassApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Discord Bypass - Kontrol Paneli")
        self.set_default_size(520, 640)
        self.set_position(Gtk.WindowPosition.CENTER)

        # Set Window Icon
        icon_path = "/usr/share/icons/hicolor/scalable/apps/discord-bypass.svg"
        if not os.path.exists(icon_path):
            local_icon = os.path.join(os.path.dirname(os.path.abspath(__file__)), "discord-bypass.svg")
            if os.path.exists(local_icon):
                icon_path = local_icon

        if os.path.exists(icon_path):
            try:
                self.set_icon_from_file(icon_path)
            except Exception:
                pass

        # Apply CSS
        try:
            style_provider = Gtk.CssProvider()
            style_provider.load_from_data(CSS_STYLE)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(),
                style_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )
        except Exception as e:
            print(f"Warning: Could not load custom CSS: {e}")

        self.binary_path = self.find_binary()
        self.build_ui()
        self.refresh_status()

        # Timer to auto-refresh every 6 seconds
        GLib.timeout_add_seconds(6, self.refresh_status)

    def find_binary(self):
        for path in ["/usr/bin/discord-bypass", "/usr/local/bin/discord-bypass", "./bin/discord-bypass"]:
            if os.path.isfile(path) and os.access(path, os.X_OK):
                return os.path.abspath(path)
        return "discord-bypass"

    def build_ui(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(vbox)

        # 1. Header
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        header.get_style_context().add_class("header-box")

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(xalign=0)
        lbl_title.set_markup("<span class='title-label'>🎮 Discord &amp; Roblox Bypass</span>")
        lbl_sub = Gtk.Label(xalign=0)
        lbl_sub.set_markup("<span class='subtitle-label'>Linux DPI Desenkronizasyon &amp; Erişim Servisi (Discord + Roblox)</span>")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(lbl_sub, False, False, 0)
        header.pack_start(title_box, True, True, 0)

        vbox.pack_start(header, False, False, 0)

        # 2. Main Content Cards Container
        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        vbox.pack_start(content_box, False, False, 6)

        # Card 1: Connection & Strategy Status
        c1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        c1.get_style_context().add_class("card")
        c1_title = Gtk.Label(xalign=0)
        c1_title.set_markup("<span class='card-title'>BAĞLANTI VE STRATEJİ DURUMU</span>")
        self.lbl_status = Gtk.Label(xalign=0)
        self.lbl_status.set_markup("<span class='status-active'>🟢 Yükleniyor...</span>")
        self.lbl_strategy = Gtk.Label(xalign=0)
        self.lbl_strategy.set_markup("<span class='info-value'>Aktif Strateji: -</span>")
        c1.pack_start(c1_title, False, False, 0)
        c1.pack_start(self.lbl_status, False, False, 0)
        c1.pack_start(self.lbl_strategy, False, False, 0)
        content_box.pack_start(c1, False, False, 0)

        # Card 2: Voice & Network Card
        c2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        c2.get_style_context().add_class("card")
        c2_title = Gtk.Label(xalign=0)
        c2_title.set_markup("<span class='card-title'>AĞ, SES &amp; ROBLOX DURUMU</span>")
        self.lbl_voice = Gtk.Label(xalign=0)
        self.lbl_voice.set_markup("<span class='info-value'>🎙️ Discord Ses: Kontrol ediliyor...</span>")
        self.lbl_roblox = Gtk.Label(xalign=0)
        self.lbl_roblox.set_markup("<span class='info-value'>🧱 Roblox Erişimi: Kontrol ediliyor...</span>")
        self.lbl_traffic = Gtk.Label(xalign=0)
        self.lbl_traffic.set_markup("<span class='info-value'>🛡️ Güvenlik Duvarı: Trafik izleniyor...</span>")
        c2.pack_start(c2_title, False, False, 0)
        c2.pack_start(self.lbl_voice, False, False, 0)
        c2.pack_start(self.lbl_roblox, False, False, 0)
        c2.pack_start(self.lbl_traffic, False, False, 0)
        content_box.pack_start(c2, False, False, 0)

        # 3. Action Buttons
        btn_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        btn_box.set_margin_start(16)
        btn_box.set_margin_end(16)
        btn_box.set_margin_top(8)

        # Primary Row
        row1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_tune = Gtk.Button(label="⚡ Ağımı Otomatik Ayarla (Tune)")
        btn_tune.get_style_context().add_class("btn-primary")
        btn_tune.connect("clicked", self.on_tune_clicked)

        btn_test = Gtk.Button(label="🔄 Test Et")
        btn_test.get_style_context().add_class("btn-secondary")
        btn_test.connect("clicked", self.on_test_clicked)

        row1.pack_start(btn_tune, True, True, 0)
        row1.pack_start(btn_test, False, False, 0)
        btn_box.pack_start(row1, False, False, 0)

        # Secondary Row
        row2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_diag = Gtk.Button(label="🛠️ Ağ Teşhisi Yap (Diagnose)")
        btn_diag.get_style_context().add_class("btn-secondary")
        btn_diag.connect("clicked", self.on_diagnose_clicked)

        self.btn_service = Gtk.Button(label="🛑 Servisi Durdur")
        self.btn_service.get_style_context().add_class("btn-danger")
        self.btn_service.connect("clicked", self.on_toggle_service)

