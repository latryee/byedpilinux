        row2.pack_start(self.btn_service, False, False, 0)
        btn_box.pack_start(row2, False, False, 0)

        content_box.pack_start(btn_box, False, False, 0)

        # 4. Console Output Log Box (Collapsible/Scrollable)
        log_label = Gtk.Label(label="CANLI ÇIKTI &amp; LOG", xalign=0)
        log_label.set_markup("<span class='card-title'>CANLI ÇIKTI &amp; LOG</span>")
