class StatusNotifierTray:
    """Universal D-Bus StatusNotifierItem implementation for desktop taskbar tray."""
    def __init__(self, app):
        self.app = app
        self.bus = None
        self.reg_id = None
        self.init_dbus()

    def init_dbus(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            xml = """
            <node>
              <interface name='org.kde.StatusNotifierItem'>
                <method name='ContextMenu'>
                  <arg type='i' name='x' direction='in'/>
                  <arg type='i' name='y' direction='in'/>
                </method>
                <method name='Activate'>
                  <arg type='i' name='x' direction='in'/>
                  <arg type='i' name='y' direction='in'/>
                </method>
                <method name='SecondaryActivate'>
                  <arg type='i' name='x' direction='in'/>
                  <arg type='i' name='y' direction='in'/>
                </method>
                <property type='s' name='Category' access='read'/>
                <property type='s' name='Id' access='read'/>
                <property type='s' name='Title' access='read'/>
                <property type='s' name='Status' access='read'/>
                <property type='s' name='IconName' access='read'/>
                <property type='s' name='ToolTip' access='read'/>
              </interface>
            </node>
            """
            node_info = Gio.DBusNodeInfo.new_for_xml(xml)
            self.reg_id = self.bus.register_object(
                "/StatusNotifierItem",
                node_info.interfaces[0],
                self.handle_method_call,
                self.handle_get_property,
                None
            )
            # Register with desktop watcher
            self.bus.call_sync(
                "org.kde.StatusNotifierWatcher",
                "/StatusNotifierWatcher",
                "org.kde.StatusNotifierWatcher",
                "RegisterStatusNotifierItem",
                GLib.Variant("(s)", ("/StatusNotifierItem",)),
                None,
                Gio.DBusCallFlags.NONE,
                1000,
                None
            )
        except Exception as e:
            print(f"StatusNotifierTray note: {e}")

    def handle_method_call(self, connection, sender, object_path, interface_name, method_name, parameters, invocation):
        if method_name in ("Activate", "SecondaryActivate"):
            GLib.idle_add(self.app.toggle_window)
        elif method_name == "ContextMenu":
            x, y = parameters.unpack()
            GLib.idle_add(self.app.show_context_menu, x, y)
        invocation.return_value(None)

    def handle_get_property(self, connection, sender, object_path, interface_name, property_name):
        if property_name == "Category":
            return GLib.Variant("s", "ApplicationStatus")
        elif property_name == "Id":
            return GLib.Variant("s", "byedpilinux")
        elif property_name == "Title":
            return GLib.Variant("s", "ByeDPI Linux - Discord & Roblox Bypass")
        elif property_name == "Status":
            return GLib.Variant("s", "Active")
        elif property_name == "IconName":
            return GLib.Variant("s", "discord-bypass")
        elif property_name == "ToolTip":
            tip = f"ByeDPI Linux: {self.app.current_strategy_name}"
            return GLib.Variant("s", tip)
        return None


class DiscordBypassApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="ByeDPI Linux - Discord & Roblox Bypass")
        self.set_default_size(560, 680)
        self.set_position(Gtk.WindowPosition.CENTER)

        self.binary_path = self.find_binary()
        self.current_strategy_id = "strategy_c"
        self.current_strategy_name = "Yükleniyor..."
        self.status_short = "Yükleniyor..."
        self._minimized_notified = False

        # Set Window Icon
        self.set_app_icon()

        # Apply CSS
        try:
            style_provider = Gtk.CssProvider()
            style_provider.load_from_data(CSS_STYLE)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(),
                style_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )
        except Exception as e:
            print(f"Warning: Could not load custom CSS: {e}")

        # Connect window close button to minimize-to-tray
        self.connect("delete-event", self.on_delete_event)

        self.build_ui()
        self.refresh_status()

        # Initialize Tray
        self.tray = StatusNotifierTray(self)

        # Auto-refresh timer every 5 seconds
        GLib.timeout_add_seconds(5, self.refresh_status)

    def set_app_icon(self):
        for path in [
            "/usr/share/icons/hicolor/scalable/apps/discord-bypass.svg",
            os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps/discord-bypass.svg"),
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "discord-bypass.svg")
        ]:
            if os.path.isfile(path):
                try:
                    self.set_icon_from_file(path)
                    return
                except Exception:
                    pass

    def find_binary(self):
        for path in ["/usr/bin/discord-bypass", "/usr/local/bin/discord-bypass", "./bin/discord-bypass"]:
            if os.path.isfile(path) and os.access(path, os.X_OK):
                return os.path.abspath(path)
        return "discord-bypass"

    def toggle_window(self):
        if self.is_visible():
            self.hide()
        else:
            self.present()

    def on_delete_event(self, widget, event):
        self.hide()
        if not self._minimized_notified:
            self._minimized_notified = True
            try:
                subprocess.Popen([
                    "notify-send", "-a", "ByeDPI Linux", "-i", "discord-bypass",
                    "ByeDPI Linux Arka Planda Aktif",
                    "Uygulama sistem tepsisinde (Tray) çalışmaya devam ediyor. Açmak için simgeye tıklayabilirsiniz."
                ])
            except Exception:
                pass
        return True

