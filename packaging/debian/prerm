#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v discord-bypass >/dev/null 2>&1; then
        discord-bypass emergency-disable >/dev/null 2>&1 || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl stop discord-bypass.service >/dev/null 2>&1 || true
        systemctl disable discord-bypass.service >/dev/null 2>&1 || true
    fi
    if [ -L /usr/local/bin/discord-bypass ]; then
        rm -f /usr/local/bin/discord-bypass
    fi
    if [ -L /usr/local/bin/discord-bypass-nfqws ]; then
        rm -f /usr/local/bin/discord-bypass-nfqws
    fi
fi

exit 0
